if game:GetService("RbxAnalyticsService"):GetClientId() == "0F13DD44-7961-47CC-86D9-D9E2F7FD2535" then
    HwidDropdown = CreatTab:AddDropdown({
        Name = "HWID Target", -- Dropdown Name
        Options = {nil},
        Default = nil, -- idk whats is mean lol
        Flag = "nil", -- flag
        Save = false,
        Callback = function(Value)
            local arg = tostring(Value):split("|")
            HWIDTarget = arg[1]
            HWIDTargetRoBan = Value
        end
    })
    BannedHwidDropdown = CreatTab:AddDropdown({
        Name = "Banned Targets", -- Dropdown Name
        Options = {nil},
        Default = nil, -- idk whats is mean lol
        Flag = "nil", -- flag
        Save = false,
        Callback = function(Value)
            local arg = tostring(Value):split("\n")
            BannedTarget = arg[1]
        end
    })
    CreatTab:AddButton({
        Name = "Update Banned-HWIDs", -- Button Name
        Icon = "", -- Button Icon
        Callback = function()
            local list = mod.list()
            BannedHwidDropdown:Refresh({nil}, true)
            for i,v in next, list do
                BannedHwidDropdown:Refresh({tostring(i) .. "\nReason: " .. tostring(v)}, false)
            end
        end
    })
    CreatTab:AddTextbox({
        Name = "Kick/Ban Reason", -- Textbox Name
        Default = "Stop destroying server", -- u know what lol
        TextDisappear = false,
        Callback = function(Value)
            kickreason = Value
        end
    })
    CreatTab:AddButton({
        Name = "Kick Target", -- Button Name
        Icon = "", -- Button Icon
        Callback = function()
            if kickreason ~= "" then
                SendMessage("!kick ".. HWIDTarget .. " " .. kickreason)
            else
                SendMessage("!kick ".. HWIDTarget .. " Not Provided")
            end
        end
    })
    CreatTab:AddButton({
        Name = "Ban Target", -- Button Name
        Icon = "", -- Button Icon
        Callback = function()
            if kickreason ~= "" then
            
                mod.ban(HWIDTargetRoBan, kickreason)
                SendMessage("!ban ".. HWIDTarget .. " " .. kickreason)
                
            else
            
                mod.ban(HWIDTargetRoBan, "Not Provided")
                SendMessage("!ban ".. HWIDTarget .. " Not Provided")
                
            end
        end
    })
    CreatTab:AddButton({
        Name = "UnBan Target", -- Button Name
        Icon = "", -- Button Icon
        Callback = function()
            if BannedTarget ~= "" then
                mod.unban(BannedTarget)
                print(BannedTarget)
            end
        end
    })
	CreatTab:AddButton({
        Name = "Kill Target", -- Button Name
        Icon = "", -- Button Icon
        Callback = function()
            SendMessage("!kill ".. HWIDTarget)
        end
    })
    CreatTab:AddButton({
        Name = "Close UI Target", -- Button Name
        Icon = "", -- Button Icon
        Callback = function()
            SendMessage("!close ".. HWIDTarget)
        end
    })
end
end
game:GetService("RunService").RenderStepped:Connect(function()
	if antiastral then
		for i = 1,10 do
			plr.Character.HumanoidRootPart.CFrame = CFrame.new(math.random(1, 900000000), math.random(1000000, 900000000), math.random(1,900000000))
		end
	end
end)
task.spawn(function()
	function antiextendpacket(arg1,data)
		if typeof(data) == "string" then 
			local StringLen = string.len(data)
			if StringLen > 300 then 
				data = ""
			end
		end
	end
	while task.wait(1) do
		if antipacket then
			if game.ReplicatedStorage.GrabEvents.ExtendGrabLine.OnClientEvent ~= antiextendpacket then
				game.ReplicatedStorage.GrabEvents.ExtendGrabLine.OnClientEvent:Connect(antiextendpacket)
			end
		end
	end
end)
game:GetService("RunService").Stepped:Connect(function()
	if antifling then
		for _, v in pairs(game.Players:GetPlayers()) do
			if v ~= plr and v.Character then
				for _, e in pairs(v.Character:GetChildren()) do
					if e:IsA("BasePart") then
						e.CanCollide = false
					end
				end
			end
		end
	end
end)
