local function GetCirclePosition(centerPos, radius, index)
	radius = radius or 25
	local spacing = 2
	local circumference = 2 * math.pi * radius
	local totalCount = math.floor(circumference / spacing)
	local angle = (2 * math.pi / totalCount) * (index - 1)
	
	return Vector3.new(
		centerPos.X + radius * math.cos(angle),
		centerPos.Y,
		centerPos.Z + radius * math.sin(angle)
	)
end

